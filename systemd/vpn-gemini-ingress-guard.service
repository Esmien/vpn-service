[Unit]
Description=Block new external inbound connections to Gemini egress IP
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/iptables -w -C INPUT -i ens3 -d 85.92.158.226/32 -m conntrack --ctstate NEW,INVALID -j DROP || /usr/sbin/iptables -w -I INPUT 1 -i ens3 -d 85.92.158.226/32 -m conntrack --ctstate NEW,INVALID -j DROP'
ExecStop=/usr/sbin/iptables -w -D INPUT -i ens3 -d 85.92.158.226/32 -m conntrack --ctstate NEW,INVALID -j DROP

[Install]
WantedBy=multi-user.target
