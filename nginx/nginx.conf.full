stream {
    log_format sni '$remote_addr [$time_local] port=$server_port sni=$ssl_preread_server_name bytes_in=$bytes_received bytes_out=$bytes_sent time=$session_time';
    access_log /var/log/nginx/stream-443.log sni;
    
    include /etc/nginx/stream.d/443-map.conf;
    server {
        listen 443;
        listen [::]:443;
        ssl_preread on;
        proxy_pass $mtproto_backend;
        proxy_protocol on;
        proxy_connect_timeout 5s;
        proxy_timeout 1h;
    }
    # тот же REALITY, но на 4443: у части операторов TCP/443 к нашему IP режется
    server {
        listen 4443;
        listen [::]:4443;
        ssl_preread on;
        proxy_pass $mtproto_backend;
        proxy_protocol on;
        proxy_connect_timeout 5s;
        proxy_timeout 1h;
    }
}
